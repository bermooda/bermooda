// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
}

// ─── Admin / staff auth ──────────────────────────────────────────────────────

enum Role {
  admin
  staff
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  emailVerified    Boolean  @default(false)
  name             String?
  image            String?
  twoFactorEnabled Boolean  @default(true)
  role             Role     @default(staff)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  twoFactor TwoFactor?

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, token])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @unique
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model TwoFactor {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String
  backupCodes String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Customer auth ───────────────────────────────────────────────────────────

model Customer {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    Boolean   @default(false)
  name             String?
  phone            String?
  preferredLocale  String?
  consentJson      String?
  erasedAt         DateTime?
  twoFactorEnabled Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions  CustomerSession[]
  accounts  CustomerAccount[]
  twoFactor CustomerTwoFactor?
  addresses Address[]
  carts     Cart[]
  checkouts CheckoutSession[]
  orders           Order[]
  returns          Return[]
  storeCreditLedger StoreCreditLedger[]
  reviews          Review[]
  groupMemberships CustomerGroupMember[]
  wishlists        Wishlist[]
  backInStockSubscriptions BackInStockSubscription[]
  giftCards        GiftCard[]
  loyaltyTransactions LoyaltyTransaction[]
  referralCode     ReferralCode?
  referredBy       Referral?              @relation("ReferredCustomer")
  campaignDeliveries CampaignDelivery[]

  @@index([email])
}

model CustomerSession {
  id         String   @id @default(cuid())
  token      String   @unique
  customerId String
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, token])
}

model CustomerAccount {
  id                    String    @id @default(cuid())
  accountId             String    @unique
  providerId            String
  customerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([customerId])
}

model CustomerVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model CustomerTwoFactor {
  id          String   @id @default(cuid())
  customerId  String   @unique
  secret      String
  backupCodes String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  firstName  String
  lastName   String
  company    String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Product {
  id          String    @id @default(cuid())
  productType String    @default("physical")
  publishedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants      ProductVariant[]
  categories    ProductCategory[]
  media         ProductMedia[]
  options       ProductOption[]
  attributes    ProductAttribute[]
  reviews       Review[]
  digitalAssets DigitalAsset[]
  bundleItems   BundleItem[]     @relation("BundleProduct")
  channelProducts ChannelProduct[]
}

model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  sku              String?
  inventoryCount   Int      @default(0)
  inventoryTracked Boolean  @default(true)
  taxClassId       String?
  position         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product                 Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxClass                TaxClass?                 @relation(fields: [taxClassId], references: [id])
  prices                  VariantPrice[]
  cartLines               CartLine[]
  orderLines              OrderLine[]
  inventoryLevels         InventoryLevel[]
  priceListEntries        PriceListEntry[]
  wishlistItems           WishlistItem[]
  backInStockSubscriptions BackInStockSubscription[]
  bundleComponents        BundleItem[]
  channelPriceOverrides   ChannelPriceOverride[]

  @@index([productId])
  @@index([sku])
  @@index([taxClassId])
}

model VariantPrice {
  id                String   @id @default(cuid())
  variantId         String
  currency          String
  priceCents        Int
  comparePriceCents Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, currency])
  @@index([variantId])
}

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@index([productId])
}

model ProductOptionValue {
  id        String   @id @default(cuid())
  optionId  String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId])
}

model Category {
  id        String   @id @default(cuid())
  parentId  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]        @relation("CategoryTree")
  products  ProductCategory[]
  menuItems MenuItem[]

  @@index([parentId])
}

model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  categoryId String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
}

model Media {
  id           String   @id @default(cuid())
  storageKey   String
  url          String
  mimeType     String
  width        Int?
  height       Int?
  variantsJson String?
  altText      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productMedia ProductMedia[]
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  mediaId   String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaId])
  @@index([mediaId])
}

// ─── Cart + Checkout + Orders ─────────────────────────────────────────────────

model Cart {
  id             String    @id @default(cuid())
  customerId     String?
  salesChannelId String?
  token          String    @unique
  currency       String    @default("USD")
  lockedAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer     Customer?     @relation(fields: [customerId], references: [id])
  salesChannel SalesChannel? @relation(fields: [salesChannelId], references: [id])
  lines      CartLine[]
  checkouts  CheckoutSession[]
  discounts  CartDiscount[]

  @@index([customerId])
  @@index([salesChannelId])
  @@index([token])
}

model CartLine {
  id                 String   @id @default(cuid())
  cartId             String
  variantId          String?
  quantity           Int
  priceCentsSnapshot Int
  titleSnapshot      String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([cartId])
}

model CheckoutSession {
  id                  String    @id @default(cuid())
  cartId              String
  customerId          String?
  salesChannelId      String?
  email               String?
  step                String    @default("address")
  shippingAddressJson String?
  billingAddressJson  String?
  shippingOptionJson  String?
  paymentIntentId     String?
  paymentProvider     String?
  couponCode          String?
  giftCardCode        String?
  storeCreditCents    Int       @default(0)
  loyaltyPointsCents  Int       @default(0)
  vatId               String?
  taxExempt           Boolean   @default(false)
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  cart         Cart          @relation(fields: [cartId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  salesChannel SalesChannel? @relation(fields: [salesChannelId], references: [id])

  @@index([cartId])
  @@index([customerId])
}

model Order {
  id                  String   @id @default(cuid())
  orderNumber         String   @unique
  customerId          String?
  salesChannelId      String?
  email               String
  status              String   @default("pending")
  currency            String
  subtotalCents       Int
  shippingCents       Int      @default(0)
  taxCents            Int      @default(0)
  discountCents       Int      @default(0)
  storeCreditCents      Int      @default(0)
  giftCardCents         Int      @default(0)
  loyaltyPointsCents    Int      @default(0)
  totalCents          Int
  shippingAddressJson String
  billingAddressJson  String?
  paymentProvider     String?
  paymentIntentId     String?
  couponCode          String?
  vatId               String?
  taxExempt           Boolean  @default(false)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer     Customer?     @relation(fields: [customerId], references: [id])
  salesChannel SalesChannel? @relation(fields: [salesChannelId], references: [id])
  lines      OrderLine[]
  shipments  Shipment[]
  refunds    Refund[]
  returns    Return[]
  discounts  OrderDiscount[]
  giftCardRedemptions GiftCardRedemption[]

  @@index([customerId])
  @@index([salesChannelId])
  @@index([orderNumber])
  @@index([status])
}

model OrderLine {
  id                String   @id @default(cuid())
  orderId           String
  variantId         String?
  title             String
  sku               String?
  quantity          Int
  fulfilledQuantity Int      @default(0)
  returnedQuantity  Int      @default(0)
  priceCents        Int
  totalCents        Int
  createdAt         DateTime @default(now())

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  shipmentLines ShipmentLine[]
  returnLines   ReturnLine[]

  @@index([orderId])
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  status         String    @default("pending")
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines ShipmentLine[]

  @@index([orderId])
}

model ShipmentLine {
  id          String   @id @default(cuid())
  shipmentId  String
  orderLineId String
  quantity    Int
  createdAt   DateTime @default(now())

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id])

  @@index([shipmentId])
  @@index([orderLineId])
}

model Refund {
  id               String   @id @default(cuid())
  orderId          String
  amountCents      Int
  reason           String?
  status           String   @default("pending")
  providerRefundId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── Misc ─────────────────────────────────────────────────────────────────────

model Discount {
  id               String    @id @default(cuid())
  code             String    @unique
  title            String?
  type             String
  value            Int
  appliesTo        String    @default("order")
  minSubtotalCents Int?
  minQuantity      Int?
  maxUsesCount     Int?
  usedCount        Int       @default(0)
  currency         String?
  startsAt         DateTime?
  expiresAt        DateTime?
  automatic        Boolean   @default(false)
  stackable        Boolean   @default(false)
  priority         Int       @default(0)
  customerGroupId  String?
  rulesJson        String?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cartDiscounts  CartDiscount[]
  orderDiscounts OrderDiscount[]

  @@index([automatic, active])
  @@index([customerGroupId])
}

model PluginData {
  id        String   @id @default(cuid())
  pluginId  String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pluginId, key])
  @@index([pluginId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Translation {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  locale     String
  field      String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, locale, field])
  @@index([entityType, entityId])
}

model Slug {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  locale     String
  slug       String   @unique
  canonical  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, locale])
  @@index([entityType, entityId])
}

// ─── W1: Search — Product attributes for faceted filtering ──────────────────

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductAttributeValue[]

  @@index([productId])
  @@index([name])
}

model ProductAttributeValue {
  id          String   @id @default(cuid())
  attributeId String
  value       String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@index([attributeId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     String
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([provider, eventId])
  @@index([provider])
}

// ─── W2: Public API + outbound webhooks ──────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  label      String
  keyHash    String    @unique
  scopes     String    @default("[]")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([keyHash])
}

model WebhookSubscription {
  id        String   @id @default(cuid())
  label     String?
  url       String
  events    String
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id             String    @id @default(cuid())
  subscriptionId String
  event          String
  payload        String
  status         String    @default("pending")
  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  responseStatus Int?
  responseBody   String?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([event])
}

// ─── W3: Payments breadth + promotions engine + tax classes ────────────────

model TaxClass {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  rate      Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model CartDiscount {
  id            String   @id @default(cuid())
  cartId        String
  discountId    String
  code          String?
  discountCents Int      @default(0)
  createdAt     DateTime @default(now())

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([cartId, discountId])
  @@index([cartId])
  @@index([discountId])
}

model OrderDiscount {
  id            String   @id @default(cuid())
  orderId       String
  discountId    String
  code          String?
  type          String
  value         Int
  discountCents Int
  createdAt     DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id])

  @@index([orderId])
  @@index([discountId])
}

// ─── W4: Returns/RMA, fulfillment depth, documents ───────────────────────────

model Return {
  id               String   @id @default(cuid())
  orderId          String
  customerId       String?
  status           String   @default("requested")
  reason           String?
  resolution       String?
  storeCreditCents Int?
  exchangeOrderId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId], references: [id])
  lines    ReturnLine[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model ReturnLine {
  id          String   @id @default(cuid())
  returnId    String
  orderLineId String
  quantity    Int
  restocked   Boolean  @default(false)
  createdAt   DateTime @default(now())

  return    Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id])

  @@index([returnId])
  @@index([orderLineId])
}

model StoreCreditLedger {
  id                String   @id @default(cuid())
  customerId        String
  amountCents       Int
  balanceAfterCents Int
  reason            String?
  referenceType     String?
  referenceId       String?
  createdAt         DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([referenceType, referenceId])
}

// ─── W5: CMS, navigation, reviews ───────────────────────────────────────────

model Page {
  id          String    @id @default(cuid())
  type        String    @default("page")
  status      String    @default("draft")
  publishedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  menuItems MenuItem[]

  @@index([status])
  @@index([publishedAt])
}

model Menu {
  id        String   @id @default(cuid())
  handle    String   @unique
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]
}

model MenuItem {
  id         String   @id @default(cuid())
  menuId     String
  parentId   String?
  label      String
  url        String?
  pageId     String?
  categoryId String?
  position   Int      @default(0)
  openInNew  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuTree")
  page     Page?      @relation(fields: [pageId], references: [id], onDelete: SetNull)
  category Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([menuId])
  @@index([parentId])
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  customerId       String
  rating           Int
  title            String?
  body             String
  status           String   @default("pending")
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([productId, status])
  @@index([status])
}

// ─── W6: Reporting, audit, compliance ────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  actorType    String
  actorId      String?
  actorEmail   String?
  action       String
  entityType   String?
  entityId     String?
  diffJson     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model ScheduledExport {
  id             String    @id @default(cuid())
  label          String
  exportType     String
  filtersJson    String?
  schedule       String
  recipientEmail String?
  lastRunAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  runs ExportRun[]
}

model ExportRun {
  id                String    @id @default(cuid())
  scheduledExportId String?
  exportType        String
  status            String    @default("pending")
  rowCount          Int       @default(0)
  fileContent       String?
  error             String?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  scheduledExport ScheduledExport? @relation(fields: [scheduledExportId], references: [id], onDelete: SetNull)

  @@index([scheduledExportId])
  @@index([status])
  @@index([createdAt])
}

// ─── W7: Inventory depth, B2B, gift cards, wishlists ────────────────────────

model Location {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  isDefault   Boolean  @default(false)
  addressJson String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventoryLevels InventoryLevel[]
}

model InventoryLevel {
  id         String   @id @default(cuid())
  variantId  String
  locationId String
  quantity   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId])
  @@index([variantId])
  @@index([locationId])
}

model CustomerGroup {
  id        String   @id @default(cuid())
  name      String
  handle    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    CustomerGroupMember[]
  priceLists PriceList[]
}

model CustomerGroupMember {
  id              String   @id @default(cuid())
  customerGroupId String
  customerId      String
  createdAt       DateTime @default(now())

  group    CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerGroupId, customerId])
  @@index([customerId])
}

model PriceList {
  id              String    @id @default(cuid())
  name            String
  customerGroupId String?
  currency        String
  priority        Int       @default(0)
  active          Boolean   @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customerGroup CustomerGroup?   @relation(fields: [customerGroupId], references: [id], onDelete: SetNull)
  entries       PriceListEntry[]

  @@index([customerGroupId])
  @@index([currency, active])
}

model PriceListEntry {
  id          String   @id @default(cuid())
  priceListId String
  variantId   String
  priceCents  Int
  minQuantity Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId, minQuantity])
  @@index([variantId])
}

model GiftCard {
  id                  String    @id @default(cuid())
  code                String    @unique
  initialBalanceCents Int
  balanceCents        Int
  currency            String    @default("USD")
  customerId          String?
  status              String    @default("active")
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer    Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  redemptions GiftCardRedemption[]

  @@index([customerId])
  @@index([status])
}

model GiftCardRedemption {
  id          String   @id @default(cuid())
  giftCardId  String
  orderId     String?
  amountCents Int
  createdAt   DateTime @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([giftCardId])
  @@index([orderId])
}

model Wishlist {
  id         String   @id @default(cuid())
  customerId String
  name       String   @default("Default")
  isDefault  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  variantId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, variantId])
  @@index([wishlistId])
}

model BackInStockSubscription {
  id         String    @id @default(cuid())
  variantId  String
  customerId String?
  email      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([variantId, email])
  @@index([variantId, notifiedAt])
}

model DigitalAsset {
  id        String   @id @default(cuid())
  productId String
  fileName  String
  filePath  String
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model BundleItem {
  id                 String   @id @default(cuid())
  bundleProductId    String
  componentVariantId String
  quantity           Int      @default(1)
  createdAt          DateTime @default(now())

  bundleProduct      Product        @relation("BundleProduct", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentVariant   ProductVariant @relation(fields: [componentVariantId], references: [id], onDelete: Cascade)

  @@unique([bundleProductId, componentVariantId])
  @@index([bundleProductId])
}

// ─── W8: Platform hardening ───────────────────────────────────────────────────

model RolePermission {
  id       String @id @default(cuid())
  role     Role
  resource String
  action   String

  @@unique([role, resource, action])
  @@index([role])
}

// ─── W9: Loyalty, referrals, marketing, multi-store ────────────────────────

model LoyaltyTransaction {
  id            String   @id @default(cuid())
  customerId    String
  points        Int
  balanceAfter  Int
  reason        String?
  referenceType String?
  referenceId   String?
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([referenceType, referenceId])
}

model ReferralCode {
  id         String   @id @default(cuid())
  customerId String   @unique
  code       String   @unique
  createdAt  DateTime @default(now())

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  referrals Referral[]
}

model Referral {
  id                 String    @id @default(cuid())
  referralCodeId     String
  referredCustomerId String    @unique
  firstOrderId       String?
  rewardGrantedAt    DateTime?
  createdAt          DateTime  @default(now())

  referralCode     ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referredCustomer Customer     @relation("ReferredCustomer", fields: [referredCustomerId], references: [id], onDelete: Cascade)

  @@index([referralCodeId])
}

model MarketingSegment {
  id        String   @id @default(cuid())
  name      String
  rulesJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns MarketingCampaign[]
}

model MarketingCampaign {
  id          String    @id @default(cuid())
  segmentId   String
  name        String
  subject     String
  bodyHtml    String
  status      String    @default("draft")
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  segment    MarketingSegment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  deliveries CampaignDelivery[]

  @@index([segmentId])
  @@index([status])
}

model CampaignDelivery {
  id         String    @id @default(cuid())
  campaignId String
  customerId String
  email      String
  status     String    @default("pending")
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
}

model AbandonedCartSequence {
  id           String   @id @default(cuid())
  name         String
  stepNumber   Int
  delayMinutes Int
  subject      String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sends AbandonedCartSend[]

  @@unique([stepNumber])
}

model AbandonedCartSend {
  id         String   @id @default(cuid())
  cartId     String
  sequenceId String
  email      String
  sentAt     DateTime @default(now())

  sequence AbandonedCartSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([cartId, sequenceId])
  @@index([cartId])
}

model SalesChannel {
  id        String   @id @default(cuid())
  name      String
  handle    String   @unique
  domain    String?  @unique
  isDefault Boolean  @default(false)
  currency  String   @default("USD")
  locale    String   @default("en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts            Cart[]
  checkouts        CheckoutSession[]
  orders           Order[]
  productChannels  ChannelProduct[]
  priceOverrides   ChannelPriceOverride[]
}

model ChannelProduct {
  id        String   @id @default(cuid())
  channelId String
  productId String
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  channel SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([channelId, productId])
  @@index([channelId, published])
}

model ChannelPriceOverride {
  id         String   @id @default(cuid())
  channelId  String
  variantId  String
  currency   String
  priceCents Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  channel SalesChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([channelId, variantId, currency])
  @@index([variantId])
}
