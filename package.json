{
  "name": "cursor-stack",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "op run --env-file=.env -- react-router dev --port 3000 --host",
    "start": "react-router-serve ./build/server/index.js",
    "docker:build": "docker build -t cursor-stack .",
    "docker:run": "docker run -p 8081:8081 -p 8080:8080 --env-file .env -e DATABASE_URL=file:/app/sqlite.db cursor-stack npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma": "prisma",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@isaacs/ttlcache": "^2.1.4",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/body": "^0.3.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@react-router/dev": "^7.14.2",
    "@react-router/node": "^7.14.2",
    "@react-router/serve": "^7.15.0",
    "@sturmfrei/litequu": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.9",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "isbot": "^5.1.39",
    "litefs-js": "^2.0.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.15.0",
    "resend": "^6.12.2",
    "sonner": "^2.0.7",
    "stripe": "^22.1.0",
    "tailwindcss": "^4.2.4",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitest/coverage-v8": "^3.2.0",
    "happy-dom": "^17.4.4",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "prisma": "^7.8.0",
    "supertest": "^7.1.0",
    "vite": "^8.0.10",
    "vitest": "^3.2.0"
  }
}
