{
  "name": "bermooda",
  "version": "0.9.3",
  "private": false,
  "type": "module",
  "imports": {
    "#bermooda.config": "./bermooda.config.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build",
    "prebuild": "node scripts/ensure-bermooda-config.mjs && node scripts/install-extension-deps.mjs --omit=dev && node scripts/sync-extension-tw-sources.mjs",
    "dev": "op run --env-file=.env -- react-router dev --host",
    "start": "react-router-serve ./build/server/index.js",
    "docker:build": "docker build -t bermooda .",
    "docker:run": "docker run -p 3000:3000 --env-file .env -e DATABASE_URL=file:/data/sqlite.db bermooda",
    "setup": "node scripts/ensure-bermooda-config.mjs && npm run prisma:generate && prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma": "prisma",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check .",
    "check:i18n": "node scripts/check-i18n-key-coverage.mjs",
    "pretest": "node scripts/ensure-bermooda-config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "node scripts/ensure-bermooda-config.mjs && vitest run --coverage",
    "seed": "node --experimental-strip-types prisma/seed.js",
    "cli:bootstrap": "node scripts/cli-bootstrap.mjs",
    "cli:set-extensions": "node --experimental-strip-types scripts/cli-set-extensions.mjs",
    "extensions:install": "node scripts/install-default-extensions.mjs",
    "extensions:install-deps": "node scripts/install-extension-deps.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1106.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@isaacs/ttlcache": "^2.1.5",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-email/body": "^0.3.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-router/dev": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.13.0",
    "@sturmfrei/litequu": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.26",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "isbot": "^5.2.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "resend": "^6.18.1",
    "semver": "^7.8.5",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tailwindcss": "^4.3.3",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "supertest": "^7.2.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "files": [
    "app",
    "!app/**/*.test.js",
    "!app/**/*.test.jsx",
    "!app/**/*.test.server.js",
    "!app/**/*.test.server.jsx",
    "!app/test",
    "!app/test/**",
    "!app/test-setup.js",
    "!app/libs/auth/test-setup.server.js",
    "prisma",
    "public",
    "scripts",
    "!scripts/record-admin-design-demo.mjs",
    "!scripts/record-product-editor-demo.mjs",
    "bermooda.config.example.js",
    "prisma.config.js",
    "react-router.config.js",
    "vite.config.js",
    "Dockerfile",
    ".dockerignore",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bermooda/bermooda.git"
  },
  "homepage": "https://github.com/bermooda/bermooda",
  "description": "Open-source ecommerce platform — themed storefront, merchant admin, and REST API",
  "license": "MIT",
  "bugs": "https://github.com/bermooda/bermooda/issues"
}
