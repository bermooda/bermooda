{
  "name": "bermooda",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "op run --env-file=.env -- react-router dev --port 3000 --host",
    "start": "react-router-serve ./build/server/index.js",
    "docker:build": "docker build -t bermooda .",
    "docker:run": "docker run -p 8081:8081 -p 8080:8080 --env-file .env -e DATABASE_URL=file:/app/sqlite.db bermooda npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma": "prisma",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "node --experimental-strip-types prisma/seed.js",
    "cli:bootstrap": "node scripts/cli-bootstrap.mjs"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@isaacs/ttlcache": "^2.1.5",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/body": "^0.3.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.9",
    "@react-router/dev": "^8.0.1",
    "@react-router/node": "^8.0.1",
    "@react-router/serve": "^8.0.1",
    "@stripe/react-stripe-js": "^6.7.0",
    "@stripe/stripe-js": "^9.9.0",
    "@sturmfrei/litequu": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.20",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "isbot": "^5.1.43",
    "litefs-js": "^2.0.2",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.1",
    "resend": "^6.14.0",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "stripe": "^22.2.2",
    "tailwindcss": "^4.3.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "happy-dom": "^20.10.6",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
