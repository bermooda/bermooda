{
  "compilerOptions": {
    "target": "es2020",
    "module": "preserve",
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "#/*": ["./app/*"],
      "#prisma/client": ["./prisma/generated/client"]
    },
    "resolveJsonModule": true,
    "strict": false,
    "noEmit": true
  },
  "include": ["app/**/*.js", "app/**/*.jsx"],
  "exclude": ["node_modules", "build", "public"]
}
