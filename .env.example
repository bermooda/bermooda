# Add an additonal allowed host for ngrok (to receive polar webhooks locally)
__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=your-ngrok-host

# Local dev listen port (Vite server.port + auto config.baseUrl). Default: 3000.
# PORT=3000

DATABASE_URL="file:./prisma/dev.db"
# Optional override: sqlite | postgresql (auto-detected from DATABASE_URL when omitted)
# DATABASE_PROVIDER="sqlite"
QUEUE_DATABASE_PATH="./prisma/queue.db"

RESEND_API_KEY=your-resend-api-key

# Email transport plugins (Admin → Plugins → Email providers)
# Activate exactly one of: @bermooda/plugin-resend | @bermooda/plugin-sendgrid | @bermooda/plugin-ses
# Seed enables Resend by default.

# SendGrid (when the SendGrid plugin is active)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Amazon SES (when the SES plugin is active)
# SES_REGION=us-east-1
# SES_ACCESS_KEY_ID=your-ses-access-key
# SES_SECRET_ACCESS_KEY=your-ses-secret-key
# Falls back to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION when unset

BETTER_AUTH_SECRET=your-secret-key
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

STRIPE_PUBLIC_KEY=your-public-key
STRIPE_SECRET_KEY=your-secret-key
STRIPE_WEBHOOK_SECRET=your-webhook-secret

# Optional stub integrations — providers register only when the key is set
# KLARNA_API_KEY=your-klarna-api-key
# TAXJAR_API_KEY=your-taxjar-api-key
# CARRIER_API_KEY=your-carrier-api-key
# CARRIER_LIVE_RATES=true

# Meilisearch plugin (enable via Admin → Plugins)
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_API_KEY=your-meilisearch-api-key

POLAR_API_KEY=your-api-key
POLAR_WEBHOOK_SECRET=your-webhook-secret

# Healthcheck token for /health (send as X-Health-Token header)
HEALTH_TOKEN=your-health-token

# One-shot setup token for POST /api/admin/v1/setup/api-key (create first berm_ key
# without an existing API key). Prefer CLI seed/bootstrap when possible.
# Send as X-Setup-Token or Authorization: Bearer <token>.
# SETUP_TOKEN=your-setup-token

# Optional shop URL printed in seed/CLI MCP config snippets
# BERMOODA_URL=http://localhost:3000

# Error alerting and notifications (default provider: telegram)
ERROR_ALERT_PROVIDER=telegram
ERROR_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=your-token
TELEGRAM_CHAT_ID=your-chat-id
TELEGRAM_NOTIFICATIONS_ENABLED=true

# S3-compatible object storage (AWS S3, MinIO, Cloudflare R2, etc.)
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=your-bucket-name
STORAGE_ACCESS_KEY=your-access-key-id
STORAGE_SECRET_KEY=your-secret-access-key
# Public URL base for serving stored objects (usually the same as endpoint/bucket)
STORAGE_PUBLIC_URL=https://your-bucket-name.s3.amazonaws.com
